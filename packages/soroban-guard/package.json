{
	"name": "soroban-guard",
	"version": "0.4.1",
	"private": true,
	"description": "Conformance testing for deployed SEP-41 Soroban token contracts",
	"keywords": [
		"stellar",
		"soroban",
		"sep-41",
		"conformance",
		"testing"
	],
	"license": "Apache-2.0",
	"author": "Sergei Birtanov <arigatosf@gmail.com> (https://github.com/birserg)",
	"type": "module",
	"main": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"soroban-guard": "node src/cli.ts",
		"test": "vitest run tests/unit",
		"test:live": "vitest run tests/live",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@stellar/stellar-sdk": "17.0.1"
	},
	"engines": {
		"node": ">=24"
	},
	"devDependencies": {
		"@types/node": "24.13.4",
		"vitest": "5.0.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/birserg/soroban-guard.git",
		"directory": "packages/soroban-guard"
	},
	"bugs": {
		"url": "https://github.com/birserg/soroban-guard/issues"
	},
	"homepage": "https://github.com/birserg/soroban-guard#readme"
}
