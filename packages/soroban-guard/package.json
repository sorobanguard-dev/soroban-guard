{
	"name": "soroban-guard",
	"version": "0.4.2",
	"description": "Conformance testing for deployed SEP-41 Soroban token contracts",
	"keywords": [
		"stellar",
		"soroban",
		"sep-41",
		"conformance",
		"testing"
	],
	"license": "Apache-2.0",
	"author": "Sergei Birtanov <arigatosf@gmail.com> (https://github.com/birserg)",
	"type": "module",
	"bin": {
		"soroban-guard": "./dist/cli.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepack": "node scripts/prepare-package.mjs && npx --no-install tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"soroban-guard": "node src/cli.ts",
		"test": "vitest run tests/unit",
		"test:live": "vitest run tests/live",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@stellar/stellar-sdk": "17.0.1"
	},
	"engines": {
		"node": ">=24"
	},
	"devDependencies": {
		"@types/node": "24.13.4",
		"vitest": "5.0.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sorobanguard-dev/soroban-guard.git",
		"directory": "packages/soroban-guard"
	},
	"bugs": {
		"url": "https://github.com/sorobanguard-dev/soroban-guard/issues"
	},
	"homepage": "https://github.com/sorobanguard-dev/soroban-guard#readme"
}
