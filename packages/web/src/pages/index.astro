		);
	}

	.sample-track {
		display: grid;
		/* Must match `--row-gap` above, or the window stops landing on a
		   row boundary and the bottom line clips again. */
		gap: var(--row-gap, 10px);
		font-family: var(--mono);
		font-size: 12px;
		line-height: 1.5;
		/* Duration is set per card so the three do not march in lockstep. */
		animation-name: sample-drift;
		animation-timing-function: linear;
		animation-iteration-count: infinite;
	}

	/*
	 * Exactly half the track: the rows are rendered twice, so at -50% the
	 * second copy occupies the first copy's starting position and the reset
	 * to 0 is invisible. A pixel value here would need the row height
	 * hard-coded and would break the moment a line wrapped.
	 */
	@keyframes sample-drift {
		to {
			transform: translateY(-50%);
