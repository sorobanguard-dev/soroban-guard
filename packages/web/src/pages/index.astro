---
import { STATUS_GLYPH } from "soroban-guard/src/core/types.ts";
import Masthead from "../components/Masthead.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Report from "../components/Report.astro";
import StellarMark from "../components/StellarMark.astro";
import {
	RECORDED_CONTRACT,
	RECORDED_EXIT,
	RECORDED_RUN,
} from "../data/recorded-run.ts";
import { displayId } from "../data/check-id.ts";
import { NPM_URL, REPO_URL } from "../data/links.ts";
import Base from "../layouts/Base.astro";

const title = "soroban-guard — SEP-41 conformance for Soroban tokens";
const description =
	"A command-line conformance suite for deployed SEP-41 tokens on Stellar testnet. Writes are performed, not simulated, and a check that cannot reach an answer says so. Run it from your terminal, or try it in the browser.";

/**
 * The five verdicts, in the order a reader meets them: the two that are
 * about the contract, then the three that are about the run.
 */
const VERDICTS = [
	{
		key: "pass",
		status: "PASS" as const,
		name: "Pass",
		text: "The contract was asked, and it answered the way the standard requires.",
	},
	{
		key: "fail",
		status: "FAIL" as const,
		name: "Fail",
		text: "The contract did something the standard forbids. This is a finding against the token, and it sets exit 1.",
	},
	{
		key: "unverifiable",
		status: "UNVERIFIABLE" as const,
		name: "Unverifiable",
		text: "The run could not establish an answer — no counterparty key, an empty balance, a fee paid in the asset being measured. The contract is not implicated, and the row names what would turn it into a verdict.",
	},
	{
		key: "skipped",
		status: "SKIPPED" as const,
		name: "Skipped",
		text: "The check itself did not complete — an unreachable node, a malformed address, a harness fault. That is a failure of this tool, not of the contract, and the error is kept as evidence.",
	},
	{
		key: "not-implemented",
		status: "NOT_IMPLEMENTED" as const,
		name: "Not implemented",
		text: "The contract does not expose the function at all. Absence and defect are different answers.",
	},
];

/**
 * Scope, as two lists: what the tool covers, then what it does not.
 *
 * An earlier version listed one thing covered and three not, which read as
 * a tool mostly defined by its gaps. Both halves are true and both belong
 * here — the covered list says what a pass is worth, the other says where
 * it stops. Every claim is checked against the README and the code.
 */
const COVERS = [
	{
		name: "SEP-41 token interface",
		text: "All ten members. Five reads observed, five writes signed and submitted, and six checks that assert what a contract must refuse.",
	},
	{
		name: "Both kinds of token",
		text: "Stellar Asset Contracts, native XLM included, and custom WASM tokens. For a WASM token the contract spec is read first, so a member it does not declare reports NOT IMPLEMENTED without spending a call.",
	},
	{
		name: "Reports you can use",
		text: "A terminal report, a CHECKS.md, and JSON — with exit codes a CI pipeline can gate on: 0 conformant, 1 a finding, 2 no verdict reached.",
	},
];

const EXCLUDES = [
	{
		name: "Events",
		text: "Not observed yet. A token that moves balances correctly while emitting wrong or missing events still passes.",
	},
	{
		name: "Security audit",
		text: "A pass means the contract honours SEP-41 as this suite exercises it. It says nothing about admin mint, upgradeability or blacklists, all of which are SEP-41-conformant.",
	},
	{
		name: "Other standards",
		text: "SEP-41 only. It does not review WASM or check arbitrary Soroban contracts or any other SEP.",
	},
	{
		name: "Mainnet writes",
		text: "Reads work anywhere. The CLI signs writes on a test network only unless given an explicit flag; the browser checker is testnet-only.",
	},
];

/**
 * The terminal's contents, as tokens rather than markup.
 *
 * Built as data so each line renders as one element with no incidental
 * whitespace inside the `pre`, and so the typing animation has lines to
 * walk through.
 *
 * `kind` is the token's role: `c` a comment, `v` a variable name, `a` an
 * argument placeholder, and undefined for plain text. It is rendered as a
 * `tok-`-prefixed class, never bare — see the stylesheet for why.
 */
type Token = { text: string; kind?: "c" | "v" | "a" };

const TERMINAL: readonly (readonly Token[])[] = [
	// `npx`, not a path into a clone: the package is on npm, so this runs
	// with nothing installed. Seven lines exactly — the card reserves that
	// height so the typing animation never shifts the section below it.
	[{ text: "# reads only — no install, no keys", kind: "c" }],
	[
		{ text: "npx soroban-guard " },
		{ text: "<contract-id>", kind: "a" },
	],
	[],
	[{ text: "# a full run: both parties sign, all sixteen answer", kind: "c" }],
	[
		{ text: "OWNER_SECRET", kind: "v" },
		{ text: "=$(stellar keys secret owner) \\" },
	],
	[
		{ text: "SPENDER_SECRET", kind: "v" },
		{ text: "=$(stellar keys secret spender) \\" },
	],
	[
		{ text: "  npx soroban-guard " },
		{ text: "<contract-id>", kind: "a" },
	],
];

/**
 * The "run it yourself" block: two real commands against a real contract.
 *
 * The contract is `fixtures/vulnerable-token`, the deployment the recorded
 * run above was taken from. The first command needs nothing and anyone can
 * run it: only the reads can answer without a key. The second is a full
 * run as the terminal prints it, taken on 2026-09-30 with the fixture's own
 * two keys. A visitor cannot repeat that one here — only the fixture's
 * admin can mint it, so nobody else holds a balance to move — which the
 * copy says plainly; against their own token, with their own keys, it is
 * the same command.
 *
 * Output is verbatim, `sep41-` ids included, since that is what the CLI
 * prints today; the middle rows are elided and say so. Testnet is reset
 * from time to time: after a reset the fixture must be redeployed and
 * `RECORDED_CONTRACT` updated, or the first command stops working.
 */
const TRY_COMMAND = `npx soroban-guard ${RECORDED_CONTRACT}`;
const SHORT_CONTRACT = `${RECORDED_CONTRACT.slice(0, 8)}…${RECORDED_CONTRACT.slice(-7)}`;

type OutLine =
	| { kind: "group"; text: string }
	| { kind: "row"; glyph: "✓" | "✗"; id: string; said: string }
	| { kind: "more"; text: string };

// The CLI pads ids to the widest one in the run.
const ID_WIDTH = "sep41-transfer_from-unauthorized".length + 2;

const FULL_RUN: readonly OutLine[] = [
	{ kind: "group", text: "interface (3/3)" },
	{ kind: "row", glyph: "✓", id: "sep41-decimals", said: "returned 7" },
	{ kind: "row", glyph: "✓", id: "sep41-name", said: 'name is "Vulnerable Test Token"' },
	{ kind: "row", glyph: "✓", id: "sep41-symbol", said: 'symbol is "VULN"' },
	{ kind: "group", text: "behavior (6/13)" },
	{ kind: "row", glyph: "✓", id: "sep41-balance", said: "balance is 1001" },
	{
		kind: "row",
		glyph: "✓",
		id: "sep41-transfer_from-unauthorized",
		said: "an unauthorized spend was refused",
	},
	{
		kind: "row",
		glyph: "✗",
		id: "sep41-transfer-self",
		said: "the holder's balance moved from 1001 to 1002; debiting and crediting the same address must net zero, so a change means one side was applied without the other",
	},
	{
		kind: "row",
		glyph: "✗",
		id: "sep41-transfer-negative-amount",
		said: "a transfer of -1 succeeded; the holder gained, consistent with the contract reading it as a transfer in the opposite direction — anyone can withdraw from anyone",
	},
	{
		kind: "more",
		text: "… 9 more rows: 4 held, 5 unverifiable once the accounting had gone negative",
	},
];

/** The figures the tool's own design is built around. */
const FACTS = [
	{ figure: "16", label: "Checks per run" },
	{ figure: "5", label: "Verdicts, not two" },
	{ figure: "0", label: "Simulated writes" },
];

/**
 * The three cards under the hero, drawn from the recorded run rather than
 * written by hand.
 *
 * An earlier version used illustrative rows, and they contradicted each
 * other and the report below them: `balance` passed and was unverifiable in
 * the same card, `transfer_from expired` showed a pass the real run never
 * produced. The sixteen checks split exactly into five reads, five writes
 * and six refusals, so each card now shows its own real rows — no row
 * appears twice, and every verdict matches the report further down.
 */
const byId = new Map(RECORDED_RUN.map((row) => [row.id, row]));
const pick = (ids: readonly string[]) =>
	ids.map((id) => {
		const row = byId.get(id);
		if (row === undefined) {
			throw new Error(`sample card names a check the recorded run lacks: ${id}`);
		}
		return { status: row.status, id: row.id, said: row.actual };
	});

const SAMPLES = [
	{
		key: "reads",
		title: "Reads",
		explore: "Observed, not assumed",
		rows: pick([
			"sep41-decimals",
			"sep41-balance",
			"sep41-allowance",
			"sep41-name",
			"sep41-symbol",
		]),
	},
	{
		key: "writes",
		title: "Writes",
		explore: "Signed and submitted",
		rows: pick([
			"sep41-transfer",
			"sep41-approve",
			"sep41-transfer_from",
			"sep41-burn",
			"sep41-burn_from",
		]),
	},
	{
		key: "refusals",
		title: "Refusals",
		explore: "What a contract must reject",
		rows: pick([
			"sep41-transfer_from-unauthorized",
			"sep41-transfer-over-balance",
			"sep41-transfer-negative-amount",
			"sep41-transfer-zero-amount",
			"sep41-transfer-self",
			"sep41-transfer_from-expired",
		]),
	},
];
---

<Base title={title} description={description}>
	<Masthead page="home" />

	<main>
		<section class="hero">
			<a class="badge" href="/run">
				<span class="badge-tag">New</span>
				Try it in your browser — no install
				<span class="badge-arrow" aria-hidden="true">↗</span>
			</a>

			{/*
				"Built for", not "Built on": this is a command-line tool made for
				the Stellar ecosystem, not something deployed there — "on" read as
				a claim about where the tool runs. It names no standard: SEP-41 is
				in the headline directly below, and repeating it here made the
				tool read smaller than the ecosystem it serves.
			*/}
			<p class="built-on">
				Built for <StellarMark height={17} />
			</p>

			{/*
				The headline says what the tool does. The earlier "conformance
				testing for everything it can't prove" read backwards — as if it
				tested nothing it could prove. What sets it apart (saying so when a
				check cannot reach an answer) is a supporting point, so it moved to
				the lede.
			*/}
			<h1>
				Test your Soroban token<br />against SEP-41.
			</h1>

			<p class="lede">
				Sixteen checks run on-chain from your terminal. Every verdict carries
				its evidence — and a check that cannot reach an answer says so instead
				of guessing.
			</p>

			<div class="actions">
				<a class="btn primary" href="#how">Get the CLI <span aria-hidden="true">›</span></a>
				<a class="btn" href="/run">Try it in your browser</a>
			</div>
		</section>

		<section class="samples" aria-label="What the report prints">
			{
				SAMPLES.map((sample, index) => (
					<article class="sample">
						{/*
							The viewport is shorter than the list, and the track
							inside it drifts upward on a loop. The rows are emitted
							twice: the animation travels exactly one copy's height,
							so the second copy is in the first's position when it
							restarts and the wrap is invisible.
						*/}
						<div class="sample-view">
							<div
								class="sample-track"
								style={`animation-duration:${18 + index * 4}s`}
							>
								{[0, 1].map((copy) =>
									sample.rows.map((row) => (
										<div
											class="sample-row"
											data-v={row.status}
											aria-hidden={copy === 1 ? "true" : undefined}
										>
											<span class="sg" aria-hidden="true">
												{STATUS_GLYPH[row.status]}
											</span>
											<span class="sid" title={row.id}>
												{displayId(row.id).member}
												{displayId(row.id).qualifier !== undefined && (
													<span class="squal">{displayId(row.id).qualifier}</span>
												)}
											</span>
											<span class="ssaid">{row.said}</span>
										</div>
									)),
								)}
							</div>
						</div>
						<footer class="sample-foot">
							<span class="sample-title">{sample.title}</span>
							<span class="sample-explore">{sample.explore}</span>
						</footer>
					</article>
				))
			}
		</section>

		<section class="showcase" aria-label="A recorded run">
			<h2 class="showcase-head">A real run, printed in full</h2>
			<p class="sub">
				The logged run of 2026-09-27 against{" "}
				<code>fixtures/vulnerable-token</code>, row for row — not an
				illustration. Open any row to see the clause it asserts, and what an
				unverifiable one would need.
			</p>
			<Report
				rows={RECORDED_RUN}
				contractId={RECORDED_CONTRACT}
				exitCode={RECORDED_EXIT}
			/>
			<p class="provenance">
				The <code>transfer-self</code> defect was not planted — the fixture was
				written with three deliberate flaws and the tool found a fourth.
			</p>
		</section>

		<section class="split" id="how">
			<div class="prose">
				<p class="eyebrow">For developers</p>
				<h2>One command.<br />Sixteen checks.</h2>
				<p>
					On npm as <code>soroban-guard</code>. Run it with <code>npx</code> on
					Node 24 — nothing to install and nothing to configure. Point it at a
					deployed contract and it reports every clause it could exercise.
				</p>
				<div class="actions">
					{/*
						npm first: the copy above says "run it with npx", and the
						package page is where that promise is kept — version,
						install size, the README. The source is one click further.
					*/}
					<a class="btn primary" href={NPM_URL}>View on npm</a>
					<a class="btn" href={REPO_URL}>Source on GitHub</a>
				</div>
				<dl class="facts">
					{
						FACTS.map((fact) => (
							<div class="fact">
								<dt>{fact.figure}</dt>
								<dd>{fact.label}</dd>
							</div>
						))
					}
				</dl>
			</div>

			<div class="code-card">
				<div class="code-bar">
					<i class="dot red" aria-hidden="true"></i>
					<i class="dot amber" aria-hidden="true"></i>
					<i class="dot green" aria-hidden="true"></i>
					<span class="code-label">zsh</span>
				</div>
				{/*
					Rendered from `TERMINAL` with no incidental whitespace: inside
					a `pre` every space between children is significant, and the
					hand-written version broke lines apart at each token.

					Each line ships complete and visible. The typing effect is a
					progressive reveal layered on top by script, so a reader
					without JavaScript gets the commands rather than an empty box.
				*/}
				<pre class="code-out"><code>{
					TERMINAL.map((line, lineIndex) => (
						<span class="code-line" data-line={lineIndex}>{
							line.length === 0
								? " "
								: line.map((token) =>
										token.kind === undefined ? (
											token.text
										) : (
											<span class={`tok-${token.kind}`}>{token.text}</span>
										),
									)
						}</span>
					))
				}</code></pre>
				<p class="exits">
					Exits <b>0</b> conformant · <b>1</b> a finding · <b>2</b> no verdict
					reached — so a pipeline gates on the answer instead of parsing text.
				</p>
			</div>
		</section>

		<script>
			import "../scripts/terminal-typing.ts";
		</script>

		<section class="try" id="try">
			<div class="try-copy">
				<h2>Run it yourself</h2>
				<p>
					<code>fixtures/vulnerable-token</code> is live on testnet: a SEP-41
					token written with three deliberate flaws. Paste the command and the
					reads answer in seconds, no keys needed.
				</p>
				<p>
					The writes need an account that holds the token, so a full run takes
					two keys. Here is one, with the fixture's own. Point the same command
					at your token, with your keys, and you get the same report about
					yours.
				</p>
				<p>
					No keys to hand? The <a href="/run">browser checker</a> runs all
					sixteen with one Freighter wallet when it can set up a temporary
					second account — on your own token, or on a demo
					copy of this one whose faucet gives any wallet five test units.
				</p>
			</div>

			<div class="try-card">
				<p class="try-label">Try now — no keys</p>
				<div class="try-cmd">
					<code id="try-command">{TRY_COMMAND}</code>
					<button type="button" class="copy" data-copy="try-command">
						Copy
					</button>
				</div>

				<p class="try-label">A full run, both keys</p>
				{/* One block per line with no whitespace between children:
				    inside a `pre` every space is significant. */}
				<pre class="try-out"><code><span class="try-prompt">{"$ OWNER_SECRET=$(stellar keys secret alice) \\"}</span><span class="try-prompt">{"  SPENDER_SECRET=$(stellar keys secret bob) \\"}</span><span class="try-prompt">{`  npx soroban-guard ${SHORT_CONTRACT}`}</span><span class="try-head">{`SEP-41 Conformance  ${SHORT_CONTRACT}`}</span>{
					FULL_RUN.map((line) =>
						line.kind === "row" ? (
							<span class="try-line" data-g={line.glyph} style={`--id:${ID_WIDTH}ch`}><span class="tg">{line.glyph}</span><span class="tid">{line.id}</span><span class="tsaid">{line.said}</span></span>
						) : (
							<span class={line.kind === "group" ? "try-group" : "try-more"}>{line.text}</span>
						),
					)
				}<span class="try-sum"><span class="bad">2 violations found</span>{" · 9/16 checks held"}</span></code></pre>
				<p class="try-exit">
					Exits <b>1</b>: a finding. The balances move by one on every run —
					the self-transfer flaw adds a unit each time it is exercised.
				</p>
			</div>
		</section>

		<script>
			import "../scripts/copy-command.ts";
		</script>

		<section class="band" id="verdicts">
			<h2>Five verdicts, not two</h2>
			<p class="sub">
				Pass and fail are the only two about the contract. The other three are
				about the run — and each names what would turn it into a verdict.
			</p>
			<div class="vlist">
				{
					VERDICTS.map((verdict) => (
						<div class="v" data-k={verdict.key}>
							<span class="vg" aria-hidden="true">
								{STATUS_GLYPH[verdict.status]}
							</span>
							<span class="vn">{verdict.name}</span>
							<span class="vd">{verdict.text}</span>
						</div>
					))
				}
			</div>
		</section>

		<section class="band" id="scope">
			<h2>What it covers</h2>
			<p class="sub">
				Conformance, not security: a pass shows the contract honours the SEP-41
				interface as this suite exercises it.
			</p>

			<div class="scope-cols">
				<div>
					<h3 class="scope-head covers">Covers</h3>
					<ul class="scope-list">
						{
							COVERS.map((row) => (
								<li class="s covers">
									<span class="mark" aria-hidden="true">✓</span>
									<span class="sn">{row.name}</span>
									<span class="sd">{row.text}</span>
								</li>
							))
						}
					</ul>
				</div>

				<div>
					<h3 class="scope-head excludes">Does not cover</h3>
					<ul class="scope-list">
						{
							EXCLUDES.map((row) => (
								<li class="s excludes">
									<span class="mark" aria-hidden="true">–</span>
									<span class="sn">{row.name}</span>
									<span class="sd">{row.text}</span>
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</section>

		<SiteFooter />
	</main>
</Base>

<style>
	/* ── hero ─────────────────────────────────────────────────── */
	.hero {
		text-align: center;
		padding-block: 120px 64px;
		max-width: 60rem;
		margin-inline: auto;
	}

	/* On a phone 120px of black above the badge is most of a screen. */
	@media (max-width: 40rem) {
		.hero {
			padding-block: 48px 48px;
		}
	}

	/* The one pill above the headline: an announcement, not a label. */
	.badge {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		margin-bottom: var(--space-10);
		padding: 7px 8px 7px 9px;
		border-radius: var(--radius-pill);
		background: var(--raised-2);
		font-size: 14.5px;
		color: var(--ink);
		text-decoration: none;
	}

	.badge:hover {
		background: #222222;
	}

	.badge-tag {
		padding: 2px 9px;
		border-radius: var(--radius-pill);
		background: rgba(251, 191, 36, 0.14);
		color: var(--unverifiable);
		font-size: 13px;
	}

	.badge-arrow {
		display: grid;
		place-items: center;
		width: 24px;
		height: 24px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.07);
		font-size: 12px;
		color: var(--dim);
	}

	/*
	 * Attribution, not a badge: it states where the tool runs, so it is set
	 * as quiet text rather than given a pill of its own. A second pill above
	 * the headline would compete with the announcement.
	 */
	/*
	 * Flex rather than inline flow, so the logo centres against the text's
	 * optical middle instead of hanging off its baseline — the mark has no
	 * baseline of its own, and matching one by eye drifts with font size.
	 * `--dim` rather than `--faint`: beside a pure-white mark, the fainter
	 * grey read as a different, dimmer statement.
	 */
	.built-on {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 12px;
		margin: 0 0 var(--space-6);
		font-size: 15px;
		color: var(--dim);
		line-height: 1;
	}

	h1 {
		margin: 0 0 var(--space-6);
		/* Large, but light: the size carries the emphasis. A heavy weight at
		   this scale reads as shouting. */
		font-size: clamp(34px, 5.2vw, 58px);
		font-weight: 450;
		letter-spacing: -0.032em;
		line-height: 1.08;
		text-wrap: balance;
	}


	.lede {
		margin: 0 auto var(--space-10);
		font-size: clamp(16px, 2vw, 20px);
		color: var(--dim);
		max-width: 46rem;
		line-height: 1.5;
	}

	.actions {
		display: flex;
		gap: var(--space-3);
		flex-wrap: wrap;
	}

	.hero .actions {
		justify-content: center;
	}

	/* Fully round, two weights: filled for the primary path, raised for the
	   secondary. No third style and no accent colour. */
	.btn {
		font: inherit;
		font-size: 15px;
		font-weight: 500;
		padding: 12px 22px;
		border-radius: var(--radius-pill);
		border: 0;
