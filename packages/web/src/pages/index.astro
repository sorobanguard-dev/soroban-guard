	/*
	 * Height is derived from the row rhythm rather than picked: a round
	 * value like 13rem lands mid-row and clips a line in half at the
	 * bottom edge. Four rows plus their gaps is a whole number of lines.
	 */
	.sample-view {
		--row-h: 36px;
		--row-gap: 10px;
		height: calc(var(--row-h) * 4 + var(--row-gap) * 3);
		overflow: hidden;
		mask-image: linear-gradient(
