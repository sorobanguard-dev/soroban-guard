---
import Blocks from "../components/Blocks.astro";
import Masthead from "../components/Masthead.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { CHECK_REFERENCE } from "../data/check-reference.ts";
import { REPO_URL } from "../data/links.ts";
import Base from "../layouts/Base.astro";

/**
 * What each of the sixteen checks proves, built from
 * docs/check-reference.md on every deploy.
 *
 * An index on the left, the entries on the right. Every check has an
 * anchor (`/checks#transfer-self`), which the report's rows link to, so a
 * verdict is one click from the reasoning behind it.
 */
const title = "Checks — soroban-guard";
const description =
	"The sixteen SEP-41 checks soroban-guard runs: what each proves, what it needs, and when it reports unverifiable instead of guessing.";

const { method, groups } = CHECK_REFERENCE;
const total = groups.reduce((sum, group) => sum + group.checks.length, 0);
---

<Base title={title} description={description}>
	<Masthead page="checks" />

	<main>
		<header class="intro">
			<h1>The {total} checks</h1>
			<p>
				What each check proves, what it needs, and what it reports when it
				cannot reach an answer. Listed in the order a run executes them: reads
				first, then the checks that must be refused, then the writes that move
				value.
			</p>
		</header>

		<div class="layout">
			<nav class="index" aria-label="Checks">
				{
					groups.map((group) => (
						<div class="index-group">
							<p class="index-title">{group.title}</p>
							<ol>
								{group.checks.map((check) => (
									<li>
										<a href={`#${check.anchor}`}>
											{check.member}
											{check.qualifier !== undefined && (
												<span class="qual">{check.qualifier}</span>
											)}
										</a>
									</li>
								))}
							</ol>
						</div>
					))
				}
				<p class="index-title">
					<a href="#method">How the suite decides</a>
				</p>
			</nav>

			<div class="content">
				{
					groups.map((group) => (
						<section class="group">
							<h2>{group.title}</h2>
							<Blocks blocks={group.intro} />
							{group.checks.map((check) => (
								<article class="check" id={check.anchor}>
									<h3>
										<a href={`#${check.anchor}`}>
											<span class="member">{check.member}</span>
											{check.qualifier !== undefined && (
												<span class="qual">{check.qualifier}</span>
											)}
										</a>
										<span
											class="layer"
											title={
												check.layer === "interface"
													? "Reads a value; changes nothing"
													: "Observes what the contract does"
											}
										>
											{check.layer}
										</span>
									</h3>
									<p class="cli-id">
										<code>{check.id}</code> in CLI output
									</p>
									<Blocks blocks={check.body} />
								</article>
							))}
						</section>
					))
				}

				<section class="group" id="method">
					<h2>How the suite decides</h2>
					<Blocks blocks={method} />
				</section>

				<p class="source">
					Kept in the repository as
					<a href={`${REPO_URL}/blob/main/docs/check-reference.md`}
						>docs/check-reference.md</a
					>; this page is rebuilt from it on every release.
				</p>
			</div>
		</div>

		<SiteFooter />
	</main>
</Base>

<style>
	.intro {
		padding-block: 96px 56px;
		max-width: 46rem;
	}

	h1 {
		margin: 0 0 var(--space-4);
		font-size: clamp(34px, 4.6vw, 52px);
		font-weight: 450;
		letter-spacing: -0.034em;
		line-height: 1.06;
	}

	.intro p {
		margin: 0;
		color: var(--dim);
		font-size: 17px;
		line-height: 1.6;
	}

	.layout {
		display: grid;
		gap: var(--space-10);
		padding-bottom: 72px;
	}

	@media (min-width: 60rem) {
		.layout {
			grid-template-columns: 14rem minmax(0, 1fr);
			gap: var(--space-16);
		}

		.index {
			position: sticky;
			top: var(--space-6);
			align-self: start;
			max-height: calc(100vh - 48px);
			overflow-y: auto;
		}
	}

	/* On a phone the index would be a wall of links before any content;
	   the page's own order is the index there. */
	@media (max-width: 59.99rem) {
		.index {
			display: none;
		}
	}

	.index {
		display: grid;
		gap: var(--space-6);
		font-size: 13.5px;
	}

	.index-title {
		margin: 0 0 var(--space-2);
		font-size: 13px;
		font-weight: 500;
		color: var(--ink);
	}

	.index-title a {
		color: var(--ink);
		text-decoration: none;
	}

	.index ol {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 2px;
	}

	.index li a {
		display: block;
		padding: 3px 0;
		font-family: var(--mono);
		font-size: 12.5px;
		color: var(--dim);
		text-decoration: none;
	}

	.index li a:hover {
		color: var(--ink);
	}

	.qual {
		margin-left: 0.55em;
		color: var(--faint);
	}

	.content {
		display: grid;
		gap: 72px;
		min-width: 0;
	}

	.group {
		display: grid;
		gap: var(--space-6);
		scroll-margin-top: var(--space-6);
	}

	.group h2 {
		margin: 0;
		font-size: clamp(26px, 3vw, 34px);
		font-weight: 450;
		letter-spacing: -0.03em;
	}

	.check {
		display: grid;
		gap: var(--space-3);
		padding: var(--space-6);
		border-radius: var(--radius-card);
		background: var(--raised);
		scroll-margin-top: var(--space-6);
	}

	/* The entry a link landed on is the one the reader came for. */
	.check:target {
		box-shadow: inset 0 0 0 1px var(--dim);
	}

	h3 {
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-2) var(--space-4);
		font-family: var(--mono);
		font-size: 16px;
		font-weight: 500;
	}

	h3 a {
		color: var(--ink);
		text-decoration: none;
	}

	h3 .qual {
		font-weight: 400;
	}

	.layer {
		font-family: var(--sans);
		font-size: 12px;
		font-weight: 450;
		padding: 2px 9px;
		border-radius: var(--radius-pill);
		background: var(--raised-2);
		color: var(--dim);
	}

	.cli-id {
		margin: 0;
		font-size: 12.5px;
		color: var(--faint);
	}

	.cli-id code {
		color: var(--dim);
	}

	.source {
		margin: 0;
		font-size: 14px;
		color: var(--faint);
	}

	.source a {
		color: var(--dim);
	}
</style>
