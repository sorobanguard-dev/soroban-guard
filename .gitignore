node_modules/
dist/

# Astro's generated types. Rebuilt by `astro sync` on every build, and
# gitignored so Biome (which reads this file) never lints machine output.
.astro/

# Rust build output for the test fixtures. The contract source is committed;
# its compiled artifacts are not — they are rebuilt with `stellar contract
# build` and would otherwise be linted as if they were project sources.
target/

*.tsbuildinfo
.DS_Store
*.log

# Secrets — never commit keys
.env
.env.*
!.env.example
*.key

# Local probe scripts (one-off contract probes, never committed)
*.tmp.ts

# Editor-local state (personal MCP servers, output styles). Untracked and
# unread by every tool here; gitignored so it never leaks into the repo and
# Biome (which reads this file) never lints it.
.claude/settings.local.json

# Generated at pack time by scripts/prepare-package.mjs (copies of the root
# README and LICENSE with rewritten links). Never committed; the root files
# are the source of truth.
packages/soroban-guard/README.md
packages/soroban-guard/LICENSE
